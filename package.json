    "db:migrate:local": "npm run db:migrate:local --workspace backend",
    "security:audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.468.0",
